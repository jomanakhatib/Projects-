        "\n",
        "# Min–Max scale a couple of numerics\n",
        "for col in ['SquareFootage', 'Average_Temperature']:\n",
        "    if col in X.columns:\n",
        "        col_min = X[col].min() #Get the minimum values\n",
        "        col_range = X[col].max() - X[col].min() #Calculates the range of the column=the difference between the maximum and minimum values.\n",
        "        if col_range != 0: #Checks that the column doesn’t have all identical values\n",
