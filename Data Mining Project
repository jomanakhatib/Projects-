        "\n",
        "#Minimal cleaning so columns are usable like in the lab where it checks if the Energy_Consumption column is stored as text (object type).If so, it removes any units (like \"kWh\") and special characters to ensure only numeric values remain.\n",
        "# If units exist, strip them so columns are numeric for better analysis\n",
        "if df['Energy_Consumption'].dtype == 'object':\n",
        "    df['Energy_Consumption'] = (\n",
        "        df['Energy_Consumption'].astype(str) # Convert to string to allow replacements and to make sure of the object type\n",
        "        .str.replace('kWh', '', regex=False)  # Remove 'kWh' unit if it exists\n",
        "        .str.replace('[^0-9.]', '', regex=True) # Keep only numbers and floating points\n",
        "        .replace('', np.nan)  # Replace empty strings with NaN\n",
        "        .astype(float) # Convert cleaned values to float\n",
        "    )\n",
        "#Cleaning the SquareFootage column by removing units like \"m2\" and non-numeric symbols, then converts the cleaned values into numeric floats.This is done to ensure that both Energy_Consumption and SquareFootage columns are numerically formatted for modeling.\n",
        "if 'SquareFootage' in df.columns and df['SquareFootage'].dtype == 'object':\n",
        "    df['SquareFootage'] = (\n",
        "        df['SquareFootage'].astype(str)  # Convert to string\n",
        "        .str.replace('m2', '', regex=False)  # Remove 'm2' unit\n",
        "        .str.replace('[^0-9.]', '', regex=True) # Keep only numeric digits\n",
        "        .replace('', np.nan) # Replace empty values with NaN\n",
        "        .astype(float)   # Convert to float type\n",
        "    )\n",
        "\n",
        "#1) Categorical columns taht describes the building characteristics, such as type or location, which cannot be directly used in regression models.\n",
        "categorical_columns = ['Building_Type', 'Governorate', 'Occupancy_Level', 'Appliances_Usage_Level']\n",
        "\n",
        "# filters out any of the above categorical variables that might be missing in the current dataset to prevent runtime errors by keeping only the ones that actually exist in df to prevent errors if a column is missing)\n",
        "categorical_columns = [c for c in categorical_columns if c in df.columns]\n",
        "\n",
