        "    data=df,\n",
        "    columns=categorical_columns,\n",
        "    drop_first=True, #this avoids the dummy variable trap for better multicollinearity by dropping first category\n",
        "    dtype='int8' # this if for optimizes memory usage by using smaller integer type for efficiency\n",
        ")\n",
