        "# One-hot encode ANY non-numeric columns still in X\n",
        "non_numeric_cols = X_base.select_dtypes(exclude=[np.number]).columns.tolist() #finds all columns that aren’t numeric aka categorical and list them\n",
        "X = pd.get_dummies(X_base, columns=non_numeric_cols, drop_first=True, dtype='int8') #converts each categorical variable into binary 0/1 columns\n",
        "\n",
        "\n",
        "# Impute missing values in numerical columns before scaling\n",
        "numerical_cols_to_impute = X.select_dtypes(include=np.number).columns #find all numerical columns\n",
        "for col in numerical_cols_to_impute: #loop\n",
        "    X[col] = X[col].fillna(X[col].mean()) #replace the missing value \"nan\" to mean / average\n",
