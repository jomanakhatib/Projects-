        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "df = pd.read_csv('https://raw.githubusercontent.com/GUC-DM/W2025/refs/heads/main/data/energy_data.csv')\n",
        "print(\"Dataset loaded successfully. Original shape:\", df.shape)\n",
        "\n",
        "df = df.replace({r'\\u00a0': ' '}, regex=True) # Remove extra characters & clean whitespace\n",
        "for col in df.columns: #looping\n",
        "    if df[col].dtype == 'object': #checking the columns with object \"string\" data type\n",
        "        df[col] = df[col].astype(str).str.strip()  # converts all the values to strings \"\", and remove whitespaces and tabs ,newlines\n",
        "\n",
        "#Normalize categorical text\n",
        "text_cols = [\"Building_Type\", \"Governorate\", \"Neighborhood\",\n",
        "             \"Day_of_Week\", \"Occupancy_Level\", \"Appliances_Usage_Level\"] #choose the columns I want to normalize and clean it\n",
        "\n",
        "for col in text_cols: #start looping on all columns\n",
        "    if col in df.columns:\n",
        "        df[col] = (\n",
        "            df[col]\n",
        "            .astype(str)\n",
        "            .str.replace(r'[^A-Za-z\\s]', '', regex=True)# remove symbols and numbers\n",
        "            .str.lower() #Lower case the characters\n",
        "            .str.title() #Captilize first letter per word\n",
        "            .replace('Nan', np.nan) #replace 'Nan' to be known by that this value is missing not just the word nan\n",
        "        )\n",
        "\n",
        "gov_map = (\n",
        "    df.groupby(\"Neighborhood\")[\"Governorate\"].agg(lambda x: x.mode().iloc[0] if not x.mode().empty else np.nan).dropna().to_dict() # if governante is missing then we chould check the neighborhood and compare with the same neighborhood in other row then infere it and replace it in the missing one , because we can intrept it it's better to do it this way instead of mode\n",
        ")\n",
        "mask = df[\"Governorate\"].isna() & df[\"Neighborhood\"].notna()  #selecting rows where Governorate is missing but Neighborhood is present.\n",
        "df.loc[mask, \"Governorate\"] = df.loc[mask, \"Neighborhood\"].map(gov_map) # assigns values to the missing Governorate cells by mapping their Neighborhood via \"gov_map\" which is comparing the governorates and neighborhood\n",
        "\n",
        "# Clean numeric columns by removing any text units and special symbols\n",
        "df['SquareFootage'] = (\n",
        "    df['SquareFootage']\n",
        "    .astype(str)#converts to string to work on it and then will convert it back to numerical value later\n",
        "    .str.replace('m2', '', regex=False) # remove m2 to avoid having multipule data types in the same column and already it's called squared footage so its known that it's squared\n",
        "    .str.replace('[^0-9.]', '', regex=True) #removes any characters/objects leaving only the digits,make sure that all thr avaliable characters are digits\n",
        "    .replace('', np.nan) #replace any missing value with \"nan\"\n",
        "    .astype(float) #converts to float data type \"0.0\", convert it back to numerical value\n",
        ")\n",
        "\n",
        "df['Energy_Consumption'] = ( #start working on Energy_Consumption column\n",
        "    df['Energy_Consumption']\n",
        "    .astype(str) #converts to string to work on it and then will convert it back to numerical value later\n",
        "    .str.replace('kWh', '', regex=False) #removes kwh also to keep the column the same data type to avoid any conflicts\n",
        "    .str.replace('[^0-9.]', '', regex=True) #make sure that all thr avaliable characters are digits,removes any characters/objects leaving only the digits\n",
        "    .replace('', np.nan) #replace any missing value with nan\n",
        "    .astype(float)#converts to float data type \"0.0\", convert it back to numerical value\n",
        ")\n",
        "\n",
        "#Convert date column to datetime in order to be used in Days_since_last_maintenance column\n",
        "df['Last_Maintenance_Date'] = pd.to_datetime(df['Last_Maintenance_Date'], errors='coerce')# we want later to have a new column called Days_since_last_maintenance, which will be interferd from Last_Maintenance_Date so we convert it to datetime in order to be able to calculate it\n",
        "\n",
        "#Handle missing values\n",
        "# In Numeric columns by replacing with mean\n",
        "num_cols = df.select_dtypes(include='number').columns #selecct columns with numerical values\n",
        "for col in num_cols:#start looping on the chosen columns\n",
        "    df[col] = df[col].fillna(df[col].mean())  #if there's any missing value we replaced it with the mean \" the average\" in order not to leave it null\n",
        "\n",
        "#In Categorical columns by replacing with mode\n",
        "cat_cols = df.select_dtypes(exclude='number').columns #choosing the columns with categorical values\n",
        "for col in cat_cols:#start looping on them\n",
        "    df[col] = df[col].fillna(df[col].mode()[0]) #if null/missing categorical values we replace it with mode \"the most frequent \" objects/characaters\n",
        "\n",
        "#Feature Engineering\n",
        "# a) Days since last maintenance\n",
        "df['Days_since_last_maintenance'] = ( #new column for it\n",
        "    pd.to_datetime('2025-10-01') - df['Last_Maintenance_Date'] #getting the diffrence between the set date and the last Maintenance date which we converted earlier to daytime\n",
        ").dt.days #puts the diffrence in the column\n",
        "\n",
        "# b) Day_type (Weekday/Weekend)\n",
        "df['Day_type'] = df['Day_of_Week'].apply( #new column for it and .apply to be able to use the lambada conndtion next\n",
        "    lambda x: 'Weekend' if x in ['Friday', 'Saturday'] else 'Weekday' #for each day we check if it was friday or saturday we set it as weekend any day else will be weekday\n",
        ")\n",
        "\n",
        "display(df.head(6)) #checking first 6 rows to make sure my data is well cleaned and I reached my goal\n",
        "display(df.tail()) #checking the last 5 rows to be more sure that my algorithm is cleaning the data as it should be\n",
        "#The purpose of cleaning the data here to remove any inconsistencies and have a well cleaned data that can be used for modeling and presentation, We Filled any missing values in the categorical columns by mode \"the most frequent characteds/object\" except Governorate because it can be interfered from the Neighborhood column by comparing with the other rows, added to that we replaced the missing values in the numerical columns by mean which is \" average\"\n",
        "# we also cleaned the data by normalizing all columns by removing any white spaces and sepacial characters  , and Capitalziing the first letter of each word and lower case the rest of the word, and if there was mix of data types we set it to a one data type for example we removed m2 from squarefootage and left it numerical only same for Energy_Consumption we removed kwh and left it only numerical\n",
        "#lastly we added 2 new columns ,1 Days_since_last_maintenance   that calculates the diffrence between the set date and Last_Maintenance_Date \"which we converted it to date time to be able to use it here\" and then put it it in the cloumn\n",
        "#2 Day_type which works on comapring the column \"Day_of_Week\" if it was = to Friday or Saturday to set it in the new column by weekend and any other day set it to weekday"
      ]
    },
